// Plataforma Gigi's Playhouse México
// Esquema de datos: usuarios (roles), estudiantes, programas, inscripciones y evaluaciones.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cuentas del sistema: la directora administra todo; las terapeutas consultan y registran.
model User {
  id           String  @id @default(cuid())
  name         String
  username     String  @unique // Identificador de acceso (usuario). Para alumnos: su matrícula.
  email        String? @unique // Opcional: dato de contacto, ya no se usa para entrar
  passwordHash String
  role         Role    @default(TERAPEUTA)
  active       Boolean @default(true)

  /// Solo para COORDINADOR: de qué coordinación es. null = coordina todo.
  coordination Coordination?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Contraseña inicial autogenerada (texto). Visible SOLO para la directora, para
  // poder entregársela/reimprimirla a la familia. No se expone al cliente en general.
  initialPassword String?

  // Primera vez que vio el video tutorial de la plataforma. Mientras esté en null,
  // el tutorial se abre solo al entrar (después queda a la mano desde el inicio).
  tutorialSeenAt DateTime?

  // Última vez que la familia abrió su historial de mensajes. Sirve para marcarle
  // lo que llegó desde entonces. Vive en la cuenta y no en el navegador: si abre
  // desde el celular y luego desde otra computadora, ya los leyó ella.
  messagesSeenAt DateTime?

  // Cuenta ligada a un participante (solo para role ALUMNO).
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  evaluations         Evaluation[]      @relation("EvaluadorEvaluaciones")
  programs            Program[]         @relation("MaestroPrograma") // Programas/actividades a su cargo
  studentNotes        StudentNote[]     @relation("AutorAnotaciones") // Anotaciones que ha escrito
  announcements       Announcement[]    @relation("AutorAnuncios") // Anuncios que ha publicado
  reservationsDecided Reservation[]     @relation("DecideReservas") // Reservas que resolvió
  waitlistDecided     WaitlistRequest[] @relation("DecideListaEspera") // Solicitudes de espera que resolvió
  orgNodes            OrgNode[]         @relation("OrgCuenta") // Su caja en el organigrama
  calendarEvents      CalendarEvent[]   @relation("AutorEventos") // Eventos del calendario interno
  auditLogs           AuditLog[]        @relation("ActorAuditoria") // Movimientos registrados por esta cuenta
  legalEdits          LegalConfig[]     @relation("ConfigEditor") // Ediciones de los textos legales
  oficiosCreados      Oficio[]          @relation("OficioAutor") // Oficios que redactó
  oficiosAprobados    Oficio[]          @relation("OficioAprobador") // Oficios que aprobó (Eva)
  surveyEdits         SurveyConfig[]    @relation("SurveyEditor") // Ediciones de la encuesta

  @@index([role])
}

/// De qué coordina un coordinador, y a qué coordinación pertenece un programa.
/// No son roles aparte: el rol COORDINADOR ya existe con sus permisos, lo que
/// faltaba era DE QUÉ. Un coordinador sin coordinación coordina todo, como hasta
/// ahora; con una puesta, ve y gestiona solo lo suyo.
enum Coordination {
  EDUCACIONAL // Matemáticas, lectura, escritura, prerrequisitos…
  LENGUAJE // Terapias de lenguaje y comunicación
}

enum Role {
  DIRECTORA
  COORDINADOR // Coordinador de programas educativos
  GESTORA_OPERACIONES // Operación: participantes, programas, calendario, donativos, avisos, oficios y reportes. NO califica.
  TERAPEUTA // Da las clases: pasa lista, escribe bitácora y califica (inicial y final) en sus programas
  LECTOR // Solo mira: ve toda la plataforma y no puede modificar nada
  ALUMNO
}

/// Estudiantes ("participantes") de Gigi's Playhouse.
model Student {
  id             String        @id @default(cuid())
  matricula      String?       @unique // Matrícula Gigi's (solo dígitos). Es el usuario de acceso.
  firstName      String
  lastName       String
  birthDate      DateTime?
  gender         Gender?
  photoUrl       String?
  // Tutor / familiar responsable
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?
  address        String?
  // Notas generales (intereses, apoyos, observaciones). Datos sensibles: acceso solo autenticado.
  notes          String?
  enrollmentDate DateTime      @default(now())
  status         StudentStatus @default(ACTIVO)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Onboarding del tutor (primer ingreso). La compuerta a "clases" exige que estén
  // los tres: datos básicos + cuestionario de salud + aceptación de aviso y reglamento.
  onboardingCompletedAt DateTime? // Se marca al terminar el formulario de bienvenida
  privacyAcceptedAt     DateTime? // Cuándo aceptó el aviso de privacidad
  rulesAcceptedAt       DateTime? // Cuándo aceptó el reglamento
  consentVersion        String? // Versión de aviso/reglamento aceptada (para re-pedir si cambia)

  enrollments      Enrollment[]
  evaluations      Evaluation[]
  levelRecords     LevelRecord[] // Nivel y calificación (inicial/final) por programa y ciclo
  health           HealthProfile? // Cuestionario de salud del participante
  account          User? // Cuenta de acceso del participante (role ALUMNO)
  attendance       AttendanceRecord[] // Asistencia por clase
  studentNotes     StudentNote[] // Anotaciones del equipo sobre el participante
  reservations     Reservation[] // Reservas de actividades pedidas por la familia
  waitlistRequests WaitlistRequest[] // Actividades donde la familia se formó a esperar lugar
  donations        DonationContribution[] // Aportes de la familia a las campañas de donativos
  surveyResponses  SurveyResponse[] // Respuestas de la familia a la encuesta de fin de ciclo
  announcementsFor AnnouncementRecipient[] // Anuncios dirigidos específicamente a él
  auditLogs        AuditLog[] // Movimientos registrados sobre este participante

  @@index([status])
  @@index([lastName])
}

/// Cuestionario de salud del participante (1:1 con Student). Datos sensibles:
/// acceso solo autenticado. Lo llena el tutor en su primer ingreso.
model HealthProfile {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String  @unique

  bloodType           String? // Tipo de sangre
  allergies           String? // Alergias (o "Ninguna")
  medications         String? // Medicamentos actuales
  medicalConditions   String? // Condiciones médicas / diagnóstico
  therapies           String? // Terapias externas
  dietaryRestrictions String? // Restricciones alimentarias
  doctorName          String? // Médico de cabecera
  doctorPhone         String? // Teléfono del médico
  emergencyName       String? // Contacto de emergencia: nombre
  emergencyPhone      String? // Contacto de emergencia: teléfono
  emergencyRelation   String? // Parentesco del contacto de emergencia
  notes               String? // Observaciones de salud

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  FEMENINO
  MASCULINO
  OTRO
}

enum StudentStatus {
  ACTIVO
  INACTIVO
  EGRESADO
}

/// Programa / actividad que se ofrece a los participantes.
/// Cada programa es una actividad con horario, cupo y un maestro a cargo.
model Program {
  id          String  @id @default(cuid())
  name        String
  description String?
  area        String? // Área o categoría del programa (texto libre, descriptivo)
  color       String? // Color para identificarlo visualmente
  active      Boolean @default(true)

  /// Qué coordinación lo supervisa. null = ninguna en particular (lo ven todas las
  /// coordinaciones). El `area` de arriba es texto libre y descriptivo; esto es lo
  /// que decide quién manda.
  coordination Coordination?

  // Datos de la actividad (todos editables)
  schedule             String? // Horario (ej. "Lunes y miércoles 10:00–11:00")
  type                 String? // Tipo de actividad
  ageMin               Int? // Rango de edad: edad mínima (años)
  ageMax               Int? // Rango de edad: edad máxima (años)
  studentCapacity      Int     @default(7) // Cupo de alumnos
  collaboratorCapacity Int? // Cupo de colaboradores

  // ¿La familia puede inscribirse sola desde Mi espacio? Apagada = grupo de lista
  // preestablecida: lo arma dirección y la familia solo puede pedir lista de espera.
  // Solo cierra la puerta de la familia; dirección inscribe igual.
  allowFamilyEnroll Boolean @default(true)

  // Terapeuta a cargo del programa/actividad
  teacher   User?   @relation("MaestroPrograma", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments      Enrollment[]
  evaluations      Evaluation[]
  levels           ProgramLevel[] // Niveles propios de este programa (ordenados)
  levelRecords     LevelRecord[]
  scheduleSlots    ScheduleSlot[] // Horario estructurado (día + horas); alimenta el calendario
  classSessions    ClassSession[] // Bitácora y asistencia por fecha de clase
  studentNotes     StudentNote[] // Anotaciones ligadas a este programa
  reservations     Reservation[] // Reservas de lugar pedidas por las familias
  waitlistRequests WaitlistRequest[] // Familias formadas esperando lugar
  // En qué ciclos se ofrece. La directora arma la oferta de cada ciclo eligiendo de
  // los programas que ya existen (ej. que en Sep–Dic solo corran 7). El programa
  // sigue siendo uno solo: conserva su plantilla, sus niveles y su historial.
  cycles           Cycle[]           @relation("ProgramasDelCiclo")

  @@index([active])
  @@index([teacherId])
}

/// Nivel propio de un programa. Cada programa define su propia lista ordenada
/// (ej. Lectura: Prerrequisitos, Inicial, Intermedio, Avanzado). En él se ubica al
/// participante cada ciclo, y sobre esa ubicación se registran sus calificaciones.
model ProgramLevel {
  id          String  @id @default(cuid())
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  name        String // Nombre del nivel (ej. "Nivel intermedio")
  order       Int // Posición dentro del programa (1 = primero)
  description String? // Qué abarca el nivel (ej. "ser un lector")

  records       LevelRecord[]
  scheduleSlots ScheduleSlot[] // Horario propio del nivel (los programas por niveles lo usan)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, order])
  @@index([programId])
}

/// Ciclo escolar por temporada. Los cursos corren en tres ciclos al año:
/// Ene–Jun (largo), Jul–Ago (verano, corto) y Sep–Dic (largo).
model Cycle {
  id         String      @id @default(cuid())
  season     CycleSeason // Temporada del ciclo
  year       Int // Año calendario
  label      String // Etiqueta legible (ej. "Ene–Jun 2026")
  active     Boolean     @default(false) // Ciclo vigente para registrar
  // Encuesta de satisfacción de fin de ciclo. Cuando la directora la abre, las
  // familias deben contestarla para seguir usando Mi espacio (compuerta de acceso).
  surveyOpen Boolean     @default(false)

  // Ventana de fechas del ciclo. Sirve para saber QUÉ CLASES son de este ciclo: la
  // sesión de clase cuelga del programa y de una fecha, no del ciclo, así que sin
  // esto la asistencia "del ciclo" no se puede contar. Nulas = ciclo sin acotar.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Tope de actividades por participante en el ciclo. La dirección lo pone según
  // la carga que aguanta la casa. null = sin tope.
  maxEnrollments Int?

  records          LevelRecord[]
  enrollments      Enrollment[] // Inscripciones de este ciclo
  programs         Program[]         @relation("ProgramasDelCiclo") // Qué programas se ofrecen en este ciclo
  reservations     Reservation[] // Reservas pedidas para este ciclo
  surveyResponses  SurveyResponse[] // Respuestas a la encuesta de este ciclo
  waitlistRequests WaitlistRequest[] // Solicitudes de lista de espera de este ciclo

  createdAt DateTime @default(now())

  @@unique([season, year])
  @@index([active])
}

enum CycleSeason {
  ENE_JUN
  JUL_AGO
  SEP_DIC
}

/// Ubicación de un alumno en un nivel de un programa, en un ciclo concreto, con su
/// calificación de ese ciclo. Es la "calificación por programa" con historial por
/// ciclo (el xlsx de titulares por niveles es exactamente esto para Lectura/
/// Escritura/Matemáticas).
///
/// La calificación son DOS notas que pone la terapeuta: la INICIAL (cómo llegó al
/// empezar el ciclo) y la FINAL (cómo cerró). La diferencia entre ambas es el avance.
/// Escala 1–4 en las dos: 4 es el máximo, nunca más.
model LevelRecord {
  id             String          @id @default(cuid())
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId      String
  cycle          Cycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId        String
  level          ProgramLevel    @relation(fields: [programLevelId], references: [id], onDelete: Restrict)
  programLevelId String
  placement      PlacementStatus @default(REGULAR) // Regular / Probatorio / Posible graduado
  note           String? // Nota breve de la terapeuta

  // Calificación del ciclo (1–4). Null mientras la terapeuta no la registra.
  initialScore Int? // Con qué empezó el ciclo
  finalScore   Int? // Con qué lo cerró

  gradedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, programId, cycleId])
  @@index([programId, cycleId])
  @@index([cycleId])
}

enum PlacementStatus {
  REGULAR
  PROBATORIO
  POSIBLE_GRADUADO
}

/// Inscripción de un estudiante a un programa (relación con historial).
/// La calificación es POR PROGRAMA: un nivel que el maestro registra/actualiza
/// para el alumno en ese programa (no es un examen con título/puntaje).
model Enrollment {
  id        String           @id @default(cuid())
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  // El ciclo en el que está inscrito. Sin esto un alumno solo podía inscribirse a un
  // programa una vez en su vida, y no podía repetirlo en otro ciclo.
  cycle     Cycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId   String
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    EnrollmentStatus @default(ACTIVA)
  notes     String?

  // Calificación por programa
  level     String? // Nivel: "Inicial", "En proceso", "Logrado"
  levelNote String? // Nota breve del maestro sobre el nivel
  gradedAt  DateTime? // Última vez que se registró la calificación

  createdAt DateTime @default(now())

  @@unique([studentId, programId, cycleId])
  @@index([programId])
  @@index([cycleId])
}

enum EnrollmentStatus {
  ACTIVA
  PAUSADA
  FINALIZADA
}

/// Evaluación / calificación de un estudiante en un momento dado.
model Evaluation {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId   String?
  date        DateTime @default(now())
  title       String
  score       Float? // Calificación numérica (opcional)
  scale       String? // Escala o rúbrica usada (ej. "1-10", "Logrado / En proceso")
  level       String? // Nivel cualitativo (ej. "Logrado", "En proceso", "Inicial")
  notes       String?
  evaluator   User?    @relation("EvaluadorEvaluaciones", fields: [evaluatorId], references: [id], onDelete: SetNull)
  evaluatorId String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([date])
}

/// Horario estructurado de un programa: en qué día y de qué hora a qué hora hay
/// clase. Un programa puede tener varios (ej. lunes y miércoles). Es lo que pinta
/// el calendario; el campo de texto `schedule` queda como descripción libre.
model ScheduleSlot {
  id             String        @id @default(cuid())
  program        Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId      String
  // Nivel al que pertenece el horario. null = horario de todo el programa (formatos
  // PLANO sin niveles, o programas que no separan horario por nivel). Cuando se llena,
  // el horario es propio de ese nivel (ej. Lectura Inicial a una hora, Avanzado a otra).
  level          ProgramLevel? @relation(fields: [programLevelId], references: [id], onDelete: Cascade)
  programLevelId String?
  weekday        Int // Día de la semana como Date.getDay(): 0=domingo … 6=sábado
  startTime      String // "HH:MM" en 24h (ej. "10:00")
  endTime        String // "HH:MM" en 24h (ej. "11:00")

  createdAt DateTime @default(now())

  @@index([programId])
  @@index([programLevelId])
}

/// Una clase concreta de un programa en una fecha: el "panel de control" del día.
/// Nace cuando la terapeuta pasa lista o escribe la bitácora; guarda las anotaciones
/// de esa sesión y cuelga de ella la asistencia.
model ClassSession {
  id           String   @id @default(cuid())
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId    String
  date         DateTime @db.Date // Día de la clase (sin hora)
  notes        String? // Bitácora de la clase (qué se trabajó, acuerdos, pendientes)
  canceled     Boolean  @default(false) // Clase suspendida ese día (vacaciones, evento…)
  cancelReason String? // Motivo que ve la familia

  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, date])
  @@index([date])
}

/// Asistencia de un alumno en una clase concreta.
model AttendanceRecord {
  id        String           @id @default(cuid())
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    AttendanceStatus
  note      String? // Detalle breve (ej. "llegó 20 min tarde", "aviso de la mamá")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  JUSTIFICADO
  RETARDO
}

/// Lugar de un alumno en una actividad dentro de un ciclo. Nace de dos lados:
/// cuando la familia aparta desde Mi espacio (queda APROBADA, junto con su
/// inscripción) y cuando dirección lo da de baja desde el expediente (queda
/// RECHAZADA). Ese RECHAZADA es la puerta cerrada: mientras esté así, la familia
/// no puede volver a inscribir esa actividad sola: solo dirección la reabre.
/// Única por alumno+programa+ciclo.
model Reservation {
  id          String            @id @default(cuid())
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId   String
  cycle       Cycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId     String
  status      ReservationStatus @default(PENDIENTE)
  message     String? // Mensaje opcional de la familia al pedirla
  decidedAt   DateTime? // Cuándo la resolvió dirección
  decidedBy   User?             @relation("DecideReservas", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, programId, cycleId])
  @@index([status])
  @@index([programId, cycleId])
}

/// Una caja del organigrama. Se arma a mano porque en la casa hay gente que no
/// tiene cuenta en la plataforma —patronato, voluntariado, administración— y un
/// árbol sacado solo de las cuentas los dejaría fuera. Cuando la caja SÍ es una
/// cuenta se liga con `userId`, y así el organigrama muestra su rol al día.
model OrgNode {
  id    String  @id @default(cuid())
  name  String // Nombre de la persona o del área
  title String? // Cargo (ej. "Directora general", "Patronato")
  notes String? // Nota breve visible en la caja

  /// De quién cuelga. null = está hasta arriba.
  parent   OrgNode?  @relation("OrgJerarquia", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children OrgNode[] @relation("OrgJerarquia")

  /// Cuenta de la plataforma, si la tiene.
  user   User?   @relation("OrgCuenta", fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// Orden entre hermanos.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
}

/// Una familia formada esperando lugar en una actividad. Es una PETICIÓN, no una
/// inscripción: la familia se forma en lo que quiera (aunque haya lugares, aunque
/// no sea para su edad, aunque el programa no permita que ella se inscriba sola) y
/// coordinación decide. Aceptar inscribe en el mismo movimiento.
///
/// Va aparte de `Reservation` a propósito: allá RECHAZADA significa "dirección lo
/// dio de baja", y rechazar aquí sobre esa misma fila le cerraría a la familia esa
/// actividad para todo el ciclo. Son dos cosas distintas y se guardan aparte.
model WaitlistRequest {
  id        String  @id @default(cuid())
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String
  cycle     Cycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId   String

  status  WaitlistStatus @default(EN_ESPERA)
  message String? // Lo que la familia quiera decir al formarse

  /// El lugar en la fila: quien pidió antes, va antes. Se REFRESCA si la familia
  /// vuelve a pedir después de cancelar — salirse de la fila cuesta el lugar, que
  /// es la regla honesta y la que se le puede explicar a un papá.
  requestedAt DateTime @default(now())

  decidedAt    DateTime?
  decidedBy    User?     @relation("DecideListaEspera", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedById  String?
  decisionNote String? // Por qué se aceptó o rechazó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, programId, cycleId])
  @@index([programId, cycleId, status])
  @@index([cycleId, status, requestedAt])
}

enum WaitlistStatus {
  EN_ESPERA
  ACEPTADA // Coordinación le dio lugar (y con eso quedó inscrito)
  RECHAZADA // Coordinación no le dio lugar
  CANCELADA // La familia se salió de la fila
}

enum ReservationStatus {
  PENDIENTE
  APROBADA // Tiene su lugar (la familia lo apartó, o dirección la reabrió)
  RECHAZADA // Dirección la sacó de la actividad: la familia ya no puede reinscribirla
  CANCELADA // La familia se arrepintió antes de que se resolviera
}

/// Campaña de donativos que arma la dirección para las familias. Los donativos a
/// veces son en especie, así que el cumplimiento lo marca la dirección (no se suma
/// solo). Si la campaña es obligatoria (`mandatory`) y la familia no cumple, se le
/// restringe apartar/inscribir clases hasta que cumpla o reciba una prórroga.
model DonationCampaign {
  id          String    @id @default(cuid())
  title       String
  description String?
  goalLabel   String? // Mínimo esperado en texto (ej. "$200 o material escolar"); en especie no siempre es número
  goalAmount  Int? // Mínimo sugerido en pesos (opcional; informativo)
  mandatory   Boolean   @default(false) // El "check": si es obligatoria y no cumplen, se restringe apartar clases
  active      Boolean   @default(true)
  dueDate     DateTime? @db.Date // Fecha límite (opcional)

  contributions DonationContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// Aporte de una familia a una campaña. El estado lo lleva la dirección: PENDIENTE
/// mientras no cumple, CUMPLIDO cuando entregó (dinero o especie) y GRACIA cuando se
/// le dio una prórroga (vigente hasta `graceUntil`). El registro puede no existir aún
/// para una familia: esa ausencia cuenta como PENDIENTE.
model DonationContribution {
  id         String           @id @default(cuid())
  campaign   DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  status     DonationStatus   @default(PENDIENTE)
  amount     Int? // Monto aportado en pesos (opcional; los donativos en especie van en la nota)
  note       String? // Detalle del donativo (útil para donativos en especie)
  graceUntil DateTime?        @db.Date // Prórroga: liberado hasta esta fecha inclusive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, studentId])
  @@index([studentId])
}

enum DonationStatus {
  PENDIENTE
  CUMPLIDO
  GRACIA // Prórroga vigente hasta graceUntil
}

/// Evento del calendario interno: juntas, capacitaciones, visitas, eventos de
/// recaudación, días inhábiles… Lo captura dirección y lo ve SOLO el equipo
/// (dirección, coordinación, operación y terapeutas). Nunca aparece en Mi espacio: para avisar
/// a las familias están los anuncios y la suspensión de clases.
model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @db.Date // Día del evento (sin hora)
  /// Horas opcionales "HH:MM": un evento de todo el día no las lleva.
  startTime String?
  endTime   String?
  notes     String? // Detalle: lugar, quién asiste, qué hay que llevar
  color     String? // Color para distinguirlo en la semana

  author   User?   @relation("AutorEventos", fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Anuncio de la dirección para las familias. Si `toAllActive` está activo lo ven
/// todos los participantes ACTIVOS; si no, solo los destinatarios elegidos.
model Announcement {
  id          String  @id @default(cuid())
  author      User?   @relation("AutorAnuncios", fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  title       String
  body        String
  toAllActive Boolean @default(true)

  recipients AnnouncementRecipient[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Destinatario específico de un anuncio (cuando no es para todos los activos).
model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String

  @@unique([announcementId, studentId])
  @@index([studentId])
}

/// Anotación del equipo sobre un participante. Si `visibleToFamily` está activa,
/// la familia la ve en Mi espacio: es el canal para que los padres estén enterados
/// (avances, avisos, recordatorios). Si no, es una nota interna del equipo.
model StudentNote {
  id              String   @id @default(cuid())
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String
  program         Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId       String?
  author          User?    @relation("AutorAnotaciones", fields: [authorId], references: [id], onDelete: SetNull)
  authorId        String?
  body            String
  visibleToFamily Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, visibleToFamily])
  @@index([programId])
}

/// Bitácora de cambios (auditoría). Registra quién movió qué: calificaciones,
/// inscripciones, ubicaciones de nivel y datos del participante. La ve SOLO la
/// dirección; da trazabilidad cuando hay varias manos en la plataforma.
///
/// Guarda un `actorName` como copia del nombre para que el registro sobreviva
/// aunque después se borre la cuenta que hizo el cambio (actorId se pone en null).
model AuditLog {
  id        String  @id @default(cuid())
  actor     User?   @relation("ActorAuditoria", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  actorName String // Copia del nombre de quien hizo el cambio (sobrevive al borrado)
  actorRole String? // Rol en el momento del cambio (DIRECTORA, TERAPEUTA…)

  action  String // Clave de la acción, ej. "calificacion.tema", "inscripcion.alta"
  summary String // Descripción legible del movimiento

  // A qué apunta el cambio (para agrupar/filtrar). El participante, si aplica, se
  // liga aparte para poder ver la bitácora dentro de su expediente.
  entityType String? // "Student", "Enrollment", "LevelRecord"…
  entityId   String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentId  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studentId, createdAt])
}

/// Textos legales que el tutor acepta en su primer ingreso (aviso de privacidad y
/// reglamento), editables por la dirección desde /configuracion. Es un registro
/// ÚNICO (singleton, id = 1). Al cambiar cualquiera de los textos se genera una
/// nueva `version`; como el onboarding compara la versión aceptada por la familia
/// contra la vigente, subir la versión obliga a aceptarlos de nuevo.
model LegalConfig {
  id              Int      @id @default(1) // singleton: siempre 1
  avisoPrivacidad String
  reglamento      String
  version         String // sube en cada cambio; dispara la re-aceptación de las familias
  updatedAt       DateTime @updatedAt
  updatedById     String? // quién hizo la última edición
  updatedBy       User?    @relation("ConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Zona a la que pertenece un oficio. Cada zona lleva su propia serie de folios
/// (el número de oficio es distinto entre Dirección y Operación).
enum OficioZona {
  DIRECCION
  OPERACION
}

enum OficioStatus {
  BORRADOR // Redactado, aún sin aprobar: no se puede imprimir/descargar
  APROBADO // Eva (dirección) lo aprobó: se le asignó folio y ya se puede imprimir
}

/// Oficio membretado. Lo redactan la coordinación o la dirección sobre el papel
/// oficial; Eva (dirección) lo aprueba y hasta entonces se le asigna el folio
/// definitivo (el siguiente de su zona/año) y se habilita imprimir/descargar.
/// El folio se asigna SOLO al aprobar, así que los borradores no consumen número.
model Oficio {
  id           String     @id @default(cuid())
  zona         OficioZona
  folio        Int? // Número de oficio definitivo; se asigna al aprobar (null en borrador)
  year         Int // Año de la serie de folios (el folio corre por zona + año)
  // Contenido del oficio (lo que hoy captura el editor membretado)
  lugarFecha   String? // Lugar y fecha (ej. "Ciudad de México, a 22 de julio de 2026")
  destinatario String? // A quién va dirigido
  asunto       String? // Asunto del oficio
  cuerpo       String     @default("") // Cuerpo del oficio
  firmante     String? // Quién firma (nombre y cargo)

  status       OficioStatus @default(BORRADOR)
  createdBy    User?        @relation("OficioAutor", fields: [createdById], references: [id], onDelete: SetNull)
  createdById  String?
  approvedBy   User?        @relation("OficioAprobador", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zona, year, folio]) // No se repite folio dentro de una zona/año
  @@index([zona, status])
}

/// Configuración de la encuesta de satisfacción de fin de ciclo. Registro ÚNICO
/// (singleton, id = 1). La directora edita las preguntas desde /configuracion, igual
/// que los textos legales. `questions` es la lista de preguntas (texto + tipo).
model SurveyConfig {
  id          Int      @id @default(1) // singleton: siempre 1
  /// Lista de preguntas. Forma: [{ id, text, type: "escala" | "abierta" }]
  questions   Json
  version     String // sube en cada cambio de las preguntas
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SurveyEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Respuesta de una familia a la encuesta de fin de ciclo, por ciclo. Mientras el
/// ciclo tenga la encuesta abierta y no exista esta respuesta, se bloquea Mi espacio.
model SurveyResponse {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  cycle       Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId     String
  /// Respuestas por pregunta. Forma: [{ questionId, value }] (value: número 1–5 o texto)
  answers     Json
  submittedAt DateTime @default(now())

  @@unique([studentId, cycleId])
  @@index([cycleId])
}
